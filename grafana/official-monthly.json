    {
      "id": 4,
      "type": "stat",
      "title": "本機站點來源時間涵蓋期間（臺灣時間）",
      "gridPos": {
        "x": 6,
        "y": 25,
        "w": 18,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "youbike-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "youbike-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN '尚無站點觀測；從首次成功採集開始累積'\n       ELSE to_char(min(source_at) AT TIME ZONE 'Asia/Taipei', 'YYYY-MM-DD HH24:MI:SS')\n         || '–' || to_char(max(source_at) AT TIME ZONE 'Asia/Taipei', 'YYYY-MM-DD HH24:MI:SS') END AS \"觀測期間\"\nFROM station_history"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^觀測期間$/",
          "values": true,
          "limit": 10
        },
        "orientation": "horizontal",
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value",
        "wideLayout": false,
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "月份明細與官方原始資料",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "youbike-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "youbike-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH months AS (\n    SELECT generate_series(min(month)::timestamp, max(month)::timestamp, interval '1 month')::date AS month\n    FROM official_monthly_rentals\n)\nSELECT to_char(months.month, 'YYYY-MM') AS \"月份\", report.rentals AS \"租借車次\",\n       CASE WHEN report.month IS NULL THEN '未發布（本次核對未列）' ELSE '已發布' END AS \"發布狀態\",\n       report.source_url AS \"官方原始JSON\"\nFROM months LEFT JOIN official_monthly_rentals AS report USING (month)\nORDER BY months.month"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "未發布",
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "官方原始JSON"
            },
