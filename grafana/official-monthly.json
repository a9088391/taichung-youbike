      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "youbike-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(max(month), 'YYYY-MM') AS \"最新月份\" FROM official_monthly_rentals"
